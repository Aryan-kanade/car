# ─────────────────────────────────────────────────────────────
# Copy to .env for local dev, and add the same names in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit .env — only this example file is safe to share.
# ─────────────────────────────────────────────────────────────

# ── Razorpay (Dashboard → Settings → API Keys; generate in Test mode first) ──
# Public key — also exposed to the browser as VITE_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
# Secret key — server-only, used by /api for order creation + signature checks.
RAZORPAY_KEY_SECRET=
# Webhook secret — set when creating the webhook (payment.captured, payment.failed)
# pointing at https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Same Key ID, exposed to the Vite build for the checkout modal.
VITE_RAZORPAY_KEY_ID=

# ── Shiprocket (Settings → API credentials — your panel login email/password) ──
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Optional: exact pickup location name from Shiprocket → Settings → Pickup Locations.
# Defaults to "Primary".
SHIPROCKET_PICKUP_LOCATION=
# Pickup PIN code — required for the PIN-check / COD availability / EDD feature.
SHIPROCKET_PICKUP_PINCODE=

# ── Merchant admin (/admin/orders) ──
# Any long random string. Keep it private — it lists customer orders.
ADMIN_TOKEN=

# ── Shareable tracking/payment links (HMAC signing) ──
# Optional — falls back to RAZORPAY_KEY_SECRET when unset.
TRACKING_LINK_SECRET=

# ── Order storage: Upstash Redis via its REST API (Vercel → Storage → Upstash) ──
# Auto-filled names when you attach the store to your Vercel project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
